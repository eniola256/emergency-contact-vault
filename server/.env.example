DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vault
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Public URL of this API (Bachs redirects the buyer here after paying)
API_URL=http://localhost:4000

SESSION_SECRET=change-me-to-64-random-chars
# 32 bytes as 64 hex chars:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_ENCRYPTION_KEY=

# Slot purchases are switched off. Set to true only after a payment provider (Bachs) is set up.
PAYMENTS_ENABLED=false

# Only needed when PAYMENTS_ENABLED=true. Bachs (https://docs.bachs.io). sk_sandbox_ keys hit the sandbox, sk_live_ keys hit production.
BACHS_API_KEY=sk_sandbox_xxx
# Signing secret of the webhook endpoint pointing at POST {API_URL}/api/webhooks/bachs
BACHS_WEBHOOK_SECRET=
BACHS_CURRENCY=USD

# Placeholder prices (decimal strings). Final pricing is still to be decided.
PRICE_STARTER=2.00
PRICE_PLUS=3.50
PRICE_EXTENDED=6.00

# Telegram bot used to verify phone numbers and send password-reset codes.
# Get the token from @BotFather. Never commit it. If it leaks, send /revoke to @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=EmergencyNH_bot
# polling = works on your own computer. webhook = for production (needs a public https API_URL).
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
DEFAULT_COUNTRY=NG
